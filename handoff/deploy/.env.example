# Production-only template. Copy to private shared/config/.env.production.
# All paths are absolute. Use a separate dev env with localhost origin/insecure cookie.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://mahjong.example.com
ALLOWED_ORIGINS=https://mahjong.example.com
TRUST_PROXY=loopback
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_HMAC_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_ENCODED
RECOVERY_CODE_PEPPER=REPLACE_WITH_A_DIFFERENT_PRIVATE_RANDOM_VALUE
SQLITE_PATH=/Users/MAC_USER/word-mahjong/shared/data/word-mahjong.sqlite
BACKUP_DIR=/Users/MAC_USER/word-mahjong/shared/backups
STATIC_DIR=/Users/MAC_USER/word-mahjong/current/apps/web/dist
LOG_LEVEL=info
APP_VERSION=1.0.0
# Gameplay timings belong to the versioned rules file, not environment overrides.
# Implement server startup validation: reject placeholder secrets and missing paths.
